{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "cleanupPeriodDays": 60,
  "defaultShell": "powershell",
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "language": "Chinese",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(*..*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/target.json)",
      "Read(**/*id_rsa*)",
      "Read(**/*id_ed25519*)",
      "Read(**/*credentials*)",
      "Read(**/*token*)",
      "Read(%USERPROFILE%/.claude/settings.json)",
      "Read(%USERPROFILE%/.claude/.credentials.json)",
      "Read(%USERPROFILE%/.claude/provider-profiles.json)",
      "Read(%USERPROFILE%/.codex/auth*.json)",
      "Read(%USERPROFILE%/.codex/account-usage-cache.json)",
      "Read(%USERPROFILE%/.gemini/oauth_creds.json)",
      "Read(%USERPROFILE%/.gemini/google_accounts.json)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*)",
      "Bash(rm -rf*)",
      "Bash(del /s*)",
      "Bash(format *)",
      "Bash(reg delete*)",
      "Bash(powershell:*)",
      "Bash(powershell.exe:*)"
    ]
  },
  "skipDangerousModePermissionPrompt": false,
  "tui": "fullscreen"
}
